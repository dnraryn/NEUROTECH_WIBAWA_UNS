rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verifiedEmail() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function myEmail() { return request.auth.token.email.lower(); }
    function profilePath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function companyPath(code) { return /databases/$(database)/documents/companies/$(code); }
    function memberPath(code, id) { return /databases/$(database)/documents/companies/$(code)/members/$(id); }
    function codeAccount() {
      let p = get(profilePath(request.auth.uid)).data;
      let m = get(memberPath(p.companyCode, p.memberId)).data;
      return p.schemaVersion == 2 && p.status == 'active' && m.status == 'active'
        && m.uid == request.auth.uid && m.role == p.role && m.email == myEmail()
        && m.get('loginCode','').matches('^[PSM]-[ABCDEFGHJKLMNPQRSTUVWXYZ23456789]{16}$');
    }
    function verified() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && (request.auth.token.email_verified == true || codeAccount());
    }
    function aliasMember(m) {
      return m.loginCode.matches('^[PSM]-[ABCDEFGHJKLMNPQRSTUVWXYZ23456789]{16}$')
        && m.email == m.loginCode.lower() + '@members.neurotech.invalid';
    }
    function aliasIdentity() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'password'
        && myEmail().matches('^[psm]-[abcdefghjklmnpqrstuvwxyz23456789]{16}@members[.]neurotech[.]invalid$');
    }
    function aliasInvitation(code,id) {
      let m = get(memberPath(code,id)).data;
      return aliasIdentity() && id == myEmail() && m.email == myEmail() && m.status == 'invited' && aliasMember(m);
    }
    function initialMember(code, id, uid, role) {
      let c = getAfter(companyPath(code)).data;
      return verifiedEmail() && !exists(companyPath(code)) && c.ownerUid == request.auth.uid && uid != request.auth.uid
        && ((role == 'supervisor' && c.initialSupervisorId == id) || (role == 'pekerja' && c.initialWorkerId == id));
    }
    function active(code) {
      let p = get(profilePath(request.auth.uid)).data;
      let m = get(memberPath(code, p.memberId)).data;
      return verified() && p.schemaVersion == 2 && p.status == 'active' && p.companyCode == code
        && get(companyPath(code)).data.schemaVersion == 2
        && m.uid == request.auth.uid && m.status == 'active' && m.role == p.role;
    }
    function staff(code) {
      return active(code) && get(profilePath(request.auth.uid)).data.role in ['supervisor', 'management'];
    }
    function owner(code) { return active(code) && get(companyPath(code)).data.ownerUid == request.auth.uid; }
    function mayManage(code, role) {
      return staff(code) && (role == 'pekerja'
        || (role == 'supervisor' && get(profilePath(request.auth.uid)).data.role == 'management')
        || (role == 'management' && owner(code)));
    }
    function availableIdentity() {
      return !exists(profilePath(request.auth.uid))
        || get(profilePath(request.auth.uid)).data.get('schemaVersion', 0) != 2
        || get(profilePath(request.auth.uid)).data.status == 'revoked';
    }
    function validProfile(p) {
      return p.keys().hasAll(['schemaVersion','companyCode','memberId','role','status'])
        && p.keys().hasOnly(['schemaVersion','companyCode','memberId','role','status'])
        && p.schemaVersion == 2 && p.companyCode is string && p.memberId is string
        && p.role in ['pekerja','supervisor','management'] && p.status in ['active','revoked'];
    }
    function profileLinks(uid, p) {
      let m = getAfter(memberPath(p.companyCode, p.memberId)).data;
      return validProfile(p) && p.status == 'active'
        && getAfter(companyPath(p.companyCode)).data.schemaVersion == 2
        && m.uid == uid && m.status == 'active' && m.role == p.role;
    }
    function action(code, id, verb) {
      let c = getAfter(companyPath(code)).data;
      return c.lastMemberId == id && c.lastMemberAction == verb
        && c.revision == get(companyPath(code)).data.revision + 1;
    }
    function validMember(m, id) {
      return m.keys().hasAll(['id','uid','email','name','role','roleDesc','shift','status'])
        && m.keys().hasOnly(['id','uid','email','name','role','roleDesc','shift','status','loginCode','accountCode'])
        && (!('loginCode' in m) || m.loginCode.matches('^[PSM]-[ABCDEFGHJKLMNPQRSTUVWXYZ23456789]{16}$'))
        && (!('accountCode' in m) || m.accountCode.matches('^[PSM][0-9]{3,6}$'))
        && m.id == id && m.email == id && m.email == m.email.lower()
        && m.email.size() <= 254 && m.email.matches('^[^/@ ]+@[^/@ ]+[.][^/@ ]+$')
        && m.name is string && m.name.size() > 0 && m.name.size() <= 120
        && m.roleDesc is string && m.roleDesc.size() > 0 && m.roleDesc.size() <= 120
        && m.shift in ['Pagi','Sore','Malam'] && m.role in ['pekerja','supervisor','management']
        && ((m.status == 'invited' && m.uid == null) || (m.status == 'active' && m.uid is string));
    }
    function maxWorkers(pkg) {
      return pkg == 'free' ? 1 : pkg == 'bronze' ? 10 : pkg == 'silver' ? 25 : pkg == 'gold' ? 50 : 100;
    }
    function countLimits(c) {
      return c.memberCount is int && c.workerCount is int
        && c.memberCount >= 1 && c.memberCount <= (c.package == 'free' ? 1 : 150)
        && c.workerCount >= 0 && c.workerCount <= maxWorkers(c.package);
    }
    function worker(role) { return role == 'pekerja' ? 1 : 0; }
    function claimPath(code) { return /databases/$(database)/documents/companies/$(code)/joinClaims/$(request.auth.uid); }
    function linkPath(code, token) { return /databases/$(database)/documents/companies/$(code)/joinLinks/$(token); }
    function validJoin(code) {
      let claim = getAfter(claimPath(code)).data;
      let path = linkPath(code, claim.token);
      let link = get(path).data;
      let next = getAfter(path).data;
      let m = getAfter(memberPath(code, myEmail())).data;
      let p = getAfter(profilePath(request.auth.uid)).data;
      return verified() && availableIdentity() && !exists(claimPath(code))
        && claim.uid == request.auth.uid && claim.email == myEmail() && claim.createdAt == request.time
        && claim.token.matches('^[a-f0-9]{64}$')
        && link.enabled == true && link.expiresAt > request.time && link.role == 'pekerja'
        && next.uses == link.uses + 1 && next.lastJoinedUid == request.auth.uid
        && !exists(memberPath(code, myEmail()))
        && m.role == 'pekerja' && m.uid == request.auth.uid && m.status == 'active'
        && p.companyCode == code && p.memberId == myEmail() && p.role == 'pekerja' && p.status == 'active'
        && action(code, myEmail(), 'join');
    }
    function memberCounterUpdate(code) {
      let old = resource.data;
      let next = request.resource.data;
      let id = next.lastMemberId;
      let beforePath = memberPath(code, id);
      let changed = next.diff(old).affectedKeys().hasOnly(['memberCount','workerCount','lastMemberId','lastMemberAction','revision']);
      return old.schemaVersion == 2 && changed && next.revision == old.revision + 1 && countLimits(next) && (
        (next.lastMemberAction == 'join' && id == myEmail() && validJoin(code)
          && next.memberCount == old.memberCount + 1 && next.workerCount == old.workerCount + 1)
        ||
        (next.lastMemberAction == 'add' && !exists(beforePath) && existsAfter(beforePath)
          && mayManage(code, getAfter(beforePath).data.role)
          && next.memberCount == old.memberCount + 1
          && next.workerCount == old.workerCount + worker(getAfter(beforePath).data.role))
        || (next.lastMemberAction == 'remove' && exists(beforePath) && !existsAfter(beforePath)
          && mayManage(code, get(beforePath).data.role)
          && next.memberCount == old.memberCount - 1
          && next.workerCount == old.workerCount - worker(get(beforePath).data.role))
        || (next.lastMemberAction == 'role' && owner(code) && exists(beforePath) && existsAfter(beforePath)
          && next.memberCount == old.memberCount
          && next.workerCount == old.workerCount - worker(get(beforePath).data.role) + worker(getAfter(beforePath).data.role))
      );
    }
    match /users/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid && (verifiedEmail() || aliasIdentity() || verified());
      allow list, delete: if false;
      allow create: if request.auth != null && request.auth.uid == uid && availableIdentity()
        && request.resource.data.memberId == myEmail() && profileLinks(uid,request.resource.data)
        && (aliasInvitation(request.resource.data.companyCode,request.resource.data.memberId) || verified());
      allow update: if verified() && (
        (request.auth.uid == uid && availableIdentity() && request.resource.data.memberId == myEmail()
          && profileLinks(uid, request.resource.data))
        || (resource.data.schemaVersion == 2 && validProfile(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && owner(resource.data.companyCode) && uid != request.auth.uid
          && action(resource.data.companyCode, resource.data.memberId, 'role')
          && profileLinks(uid, request.resource.data))
        || (resource.data.schemaVersion == 2 && resource.data.status == 'active'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'revoked' && uid != request.auth.uid
          && mayManage(resource.data.companyCode, resource.data.role)
          && action(resource.data.companyCode, resource.data.memberId, 'remove')
          && !existsAfter(memberPath(resource.data.companyCode, resource.data.memberId)))
      );
    }
    // A random 80-bit account identifier resolves only its Auth identifier.
    // No lists, passwords, roles, membership records, or public writes.
    match /accountLogins/{code} {
      allow get: if code.matches('^[PSM]-[ABCDEFGHJKLMNPQRSTUVWXYZ23456789]{16}$');
      allow list, update, delete: if false;
      allow create: if verified() && request.resource.data.keys().hasAll(['email','companyCode']) && request.resource.data.keys().hasOnly(['email','companyCode'])
        && request.resource.data.email is string && code.matches('^[PSM]-[ABCDEFGHJKLMNPQRSTUVWXYZ23456789]{16}$')
        && loginOwner(code,request.resource.data.email,request.resource.data.companyCode);
    }
    function loginOwner(code, email, companyCode) {
      let p = getAfter(profilePath(request.auth.uid)).data;
      let m = getAfter(memberPath(p.companyCode,email)).data;
      return p.companyCode == companyCode && m.loginCode == code && m.email == email
        && ((m.status == 'active' && m.uid == request.auth.uid) || (m.status == 'invited' && aliasMember(m)
          && (initialMember(p.companyCode,email,m.uid,m.role) || mayManage(p.companyCode,m.role)))
          || (m.status == 'active' && mayManage(p.companyCode,m.role)));
    }
    // Company + account label is a public login identifier, never an access grant.
    // Only a targeted lookup is public; no roster, role, password or EEG is listed.
    match /companyLogins/{company}/accounts/{label} {
      allow get: if company.matches('^[FBSGP]-([ABCDEFGHJKLMNPQRSTUVWXYZ23456789]{6}|[A-F0-9]{12})$')
        && label.matches('^[PSM][0-9]{3,6}$');
      allow list, update, delete: if false;
      allow create: if verified() && request.resource.data.keys().hasOnly(['loginCode'])
        && shortLoginOwner(company,label,request.resource.data.loginCode);
    }
    function shortLoginOwner(company,label,code) {
      let resolver = getAfter(/databases/$(database)/documents/accountLogins/$(code)).data;
      let m = getAfter(memberPath(company,resolver.email)).data;
      return resolver.companyCode == company && m.accountCode == label && m.loginCode == code
        && loginOwner(code,resolver.email,company);
    }
    function validInitial(c) {
      let s = getAfter(memberPath(c.code,c.initialSupervisorId)).data;
      let w = getAfter(memberPath(c.code,c.initialWorkerId)).data;
      return s.role == 'supervisor' && w.role == 'pekerja' && s.status == 'invited' && w.status == 'invited'
        && s.uid == null && w.uid == null && c.initialSupervisorId != c.initialWorkerId && aliasMember(s) && aliasMember(w);
    }
    // Human-readable identifiers are immutable labels per company. The counter is
    // advanced in the same transaction as the member, so numbers are never reused.
    function series(role) { return role == 'pekerja' ? 'P' : role == 'supervisor' ? 'S' : 'M'; }
    function accountLabel(prefix, number) {
      return prefix + (number < 10 ? '00' : number < 100 ? '0' : '') + string(number);
    }
    function sequencePath(code, prefix) { return /databases/$(database)/documents/companies/$(code)/accountCodeSequences/$(prefix); }
    function allocatedLabel(code, m) {
      let prefix = series(m.role);
      let seq = getAfter(sequencePath(code,prefix)).data;
      return seq.memberId == m.id && m.accountCode == accountLabel(prefix,seq.next - 1)
        && seq.next == (exists(sequencePath(code,prefix)) ? get(sequencePath(code,prefix)).data.next + 1 : 2);
    }
    function sequenceWrite(code, prefix) {
      let seq = request.resource.data;
      let m = getAfter(memberPath(code,seq.memberId)).data;
      return seq.keys().hasOnly(['next','memberId']) && seq.keys().hasAll(['next','memberId'])
        && seq.next is int && seq.next >= 2 && seq.next <= 1000000
        && prefix == series(m.role) && allocatedLabel(code,m)
        && (!exists(memberPath(code,m.id)) || !('accountCode' in get(memberPath(code,m.id)).data))
        && m.get('loginCode','').matches('^[PSM]-[ABCDEFGHJKLMNPQRSTUVWXYZ23456789]{16}$')
        && (mayManage(code,m.role) || (!exists(companyPath(code)) && verifiedEmail()
          && getAfter(companyPath(code)).data.ownerUid == request.auth.uid));
    }
    match /companies/{code} {
      // Missing-document reads let a verified account reserve a random unused code.
      allow get: if verified() && (!exists(companyPath(code)) || active(code));
      allow list, delete: if false;
      allow create: if verifiedEmail() && availableIdentity()
        && request.resource.data.keys().hasAll(['schemaVersion','code','companyName','package','ownerUid','createdAt','memberCount','workerCount','lastMemberId','lastMemberAction','revision','initialSupervisorId','initialWorkerId'])
        && request.resource.data.keys().hasOnly(['schemaVersion','code','companyName','package','ownerUid','createdAt','memberCount','workerCount','lastMemberId','lastMemberAction','revision','initialSupervisorId','initialWorkerId'])
        && request.resource.data.schemaVersion == 2 && request.resource.data.code == code
        && code.matches('^[FBSGP]-([ABCDEFGHJKLMNPQRSTUVWXYZ23456789]{6}|[A-F0-9]{12})$') && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.companyName is string && request.resource.data.companyName.size() > 0
        && request.resource.data.companyName.size() <= 120
        && request.resource.data.package in ['bronze','silver','gold','platinum']
        && request.resource.data.createdAt == request.time && request.resource.data.memberCount == 3
        && request.resource.data.revision == 0
        && request.resource.data.workerCount == 1
        && validInitial(request.resource.data)
        && request.resource.data.lastMemberId == myEmail() && request.resource.data.lastMemberAction == 'create'
        && getAfter(profilePath(request.auth.uid)).data.companyCode == code
        && getAfter(profilePath(request.auth.uid)).data.memberId == myEmail()
        && profileLinks(request.auth.uid, getAfter(profilePath(request.auth.uid)).data);
      allow update: if verified() && memberCounterUpdate(code);
      match /accountCodeSequences/{prefix} {
        allow get: if verified() && (staff(code) || (!exists(companyPath(code)) && verifiedEmail() && availableIdentity()));
        allow list, delete: if false;
        allow create, update: if verified() && prefix in ['P','S','M'] && sequenceWrite(code,prefix);
      }
      match /joinLinks/{token} {
        allow get: if verified() && (staff(code) ||
          (token.matches('^[a-f0-9]{64}$') && resource.data.enabled == true && resource.data.expiresAt > request.time));
        allow list: if verified() && staff(code);
        allow create: if verified() && staff(code) && token.matches('^[a-f0-9]{64}$')
          && get(companyPath(code)).data.package != 'free'
          && request.resource.data.keys().hasAll(['schemaVersion','companyName','role','createdByUid','createdAt','expiresAt','enabled','uses','lastJoinedUid'])
          && request.resource.data.keys().hasOnly(['schemaVersion','companyName','role','createdByUid','createdAt','expiresAt','enabled','uses','lastJoinedUid'])
          && request.resource.data.schemaVersion == 1 && request.resource.data.role == 'pekerja'
          && request.resource.data.companyName == get(companyPath(code)).data.companyName
          && request.resource.data.createdByUid == request.auth.uid && request.resource.data.createdAt == request.time
          && request.resource.data.expiresAt is timestamp && request.resource.data.expiresAt > request.time
          && request.resource.data.expiresAt <= request.time + duration.value(7, 'd')
          && request.resource.data.enabled == true && request.resource.data.uses == 0 && request.resource.data.lastJoinedUid == null;
        allow update: if verified() && (
          (staff(code) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enabled']) && request.resource.data.enabled == false)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uses','lastJoinedUid'])
            && getAfter(claimPath(code)).data.token == token && validJoin(code))
        );
        allow delete: if false;
      }
      match /joinClaims/{uid} {
        allow read, update, delete: if false;
        allow create: if verified() && uid == request.auth.uid
          && request.resource.data.keys().hasAll(['uid','email','token','createdAt'])
          && request.resource.data.keys().hasOnly(['uid','email','token','createdAt']) && validJoin(code);
      }
      match /members/{id} {
        allow read: if (verified() && (
          (active(code) && (staff(code) || resource.data.uid == request.auth.uid))
          || (resource.data.status == 'invited' && resource.data.email == myEmail())
        )) || (aliasIdentity() && resource.data.status == 'invited' && resource.data.email == myEmail() && aliasMember(resource.data));
        allow create: if verified() && validMember(request.resource.data, id)
          && (!('accountCode' in request.resource.data) || allocatedLabel(code,request.resource.data)) && (
          (id == myEmail() && validJoin(code))
          ||
          (!exists(companyPath(code)) && getAfter(companyPath(code)).data.ownerUid == request.auth.uid
            && id == myEmail() && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'active'
            && request.resource.data.role == 'management'
            && profileLinks(request.auth.uid, getAfter(profilePath(request.auth.uid)).data))
          || (initialMember(code,id,request.resource.data.uid,request.resource.data.role) && aliasMember(request.resource.data)
            && request.resource.data.status == 'invited' && request.resource.data.uid == null)
          || (mayManage(code, request.resource.data.role) && action(code, id, 'add') && (
            request.resource.data.status == 'invited'))
        );
        allow update: if (aliasInvitation(code,id) || verified()) && validMember(request.resource.data, id) && (
          (resource.data.status == 'invited' && resource.data.email == myEmail() && availableIdentity()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid','status'])
            && request.resource.data.status == 'active' && request.resource.data.uid == request.auth.uid
            && profileLinks(request.auth.uid, getAfter(profilePath(request.auth.uid)).data))
          || (staff(code) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shift']))
          || (resource.data.status == 'active' && !('loginCode' in resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['loginCode'])
            && (resource.data.uid == request.auth.uid || mayManage(code,resource.data.role)))
          || (!('accountCode' in resource.data) && 'accountCode' in request.resource.data
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accountCode'])
            && mayManage(code,resource.data.role) && allocatedLabel(code,request.resource.data))
          || (owner(code) && resource.data.uid != request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']) && action(code, id, 'role')
            && (resource.data.status == 'invited' || profileLinks(resource.data.uid, getAfter(profilePath(resource.data.uid)).data)))
        );
        allow delete: if verified() && mayManage(code, resource.data.role) && action(code, id, 'remove')
          && resource.data.uid != request.auth.uid && resource.data.uid != get(companyPath(code)).data.ownerUid
          && (resource.data.status == 'invited'
            || getAfter(profilePath(resource.data.uid)).data.status == 'revoked');
      }
      match /workers/{id} {
        allow read: if verified() && active(code)
          && (staff(code) || get(profilePath(request.auth.uid)).data.memberId == id);
        allow write: if false;
      }
      // Derived session summaries. Existing membership/role checks remain authoritative.
      match /sessions/{id} {
        function sessionPath() { return /databases/$(database)/documents/companies/$(code)/sessions/$(id); }
        function validSession(d) {
          return d.keys().hasOnly(['schemaVersion','id','companyCode','ownerUid','memberId','shift','source','startedAt','endedAt','updatedAt','status','protocol','algorithmVersion','receivedSamples','minutes','checkin','savedAt'])
            && d.keys().hasAll(['schemaVersion','id','companyCode','ownerUid','memberId','shift','source','startedAt','endedAt','updatedAt','status','protocol','algorithmVersion','receivedSamples','minutes','checkin','savedAt'])
            && d.schemaVersion == 1 && d.id == id && id.matches('^s-[a-z0-9]+-[a-f0-9]{16}$')
            && d.companyCode == code && d.ownerUid == request.auth.uid
            && d.memberId == get(profilePath(request.auth.uid)).data.memberId
            && d.source == 'muse' && d.shift in ['Pagi','Sore','Malam','Lembur']
            && d.protocol in ['athena','classic','unknown'] && d.algorithmVersion in ['eeg-heuristic-v3','eeg-heuristic-v4']
            && d.startedAt is number && d.startedAt > 0 && d.startedAt <= request.time.toMillis()
            && d.updatedAt is number && d.updatedAt >= d.startedAt && d.updatedAt <= request.time.toMillis() + 5000
            && d.status in ['recording','completed','interrupted']
            && ((d.status == 'recording' && d.endedAt == null) ||
              (d.status != 'recording' && d.endedAt is number && d.endedAt >= d.startedAt && d.endedAt <= request.time.toMillis() + 5000))
            && d.receivedSamples is int && d.receivedSamples >= 0 && d.receivedSamples <= 4 * 256 * 60 * 60 * 13
            && d.minutes is list && d.minutes.size() <= 721
            && d.checkin is map && d.checkin.keys().hasOnly(['sleptHours','sleepTargetHours','targetMinutes','sleepiness','note'])
            && (d.checkin.sleptHours == null || (d.checkin.sleptHours is number && d.checkin.sleptHours >= 0 && d.checkin.sleptHours <= 24))
            && d.checkin.sleepTargetHours is number && d.checkin.sleepTargetHours >= 1 && d.checkin.sleepTargetHours <= 16
            && d.checkin.targetMinutes is number && d.checkin.targetMinutes >= 1 && d.checkin.targetMinutes <= 1440
            && (d.checkin.sleepiness == null || (d.checkin.sleepiness is int && d.checkin.sleepiness >= 1 && d.checkin.sleepiness <= 5))
            && d.checkin.note is string && d.checkin.note.size() <= 500 && d.savedAt == request.time;
        }
        allow get: if verified() && active(code) && (!exists(sessionPath()) || staff(code) || resource.data.ownerUid == request.auth.uid);
        allow list: if verified() && active(code) && (staff(code) || resource.data.ownerUid == request.auth.uid);
        allow create: if verified() && active(code) && validSession(request.resource.data);
        allow update: if verified() && active(code) && resource.data.ownerUid == request.auth.uid
          && resource.data.status == 'recording' && validSession(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['endedAt','updatedAt','status','receivedSamples','minutes','checkin','savedAt'])
          && request.resource.data.receivedSamples >= resource.data.receivedSamples
          && request.resource.data.updatedAt >= resource.data.updatedAt;
        allow delete: if false;
      }
      match /liveReadings/{uid} {
        function metric(v) { return v == null || (v is number && v >= 0 && v <= 100); }
        function measurement(m) {
          return m is map && m.keys().hasAll(['fi','cli','ei','measuredAt','quality','scope','provisional','classification'])
            && m.keys().hasOnly(['fi','cli','ei','measuredAt','quality','scope','provisional','classification'])
            && metric(m.fi) && metric(m.cli) && metric(m.ei) && m.measuredAt is number && m.measuredAt > 0
            && m.quality in ['good','limited'] && m.provisional is bool
            && m.classification in ['normal','waspada','berisiko','kritis','unavailable']
            && ((m.scope == 'full' && m.fi != null && m.cli != null && m.ei != null)
              || (m.scope == 'frontal-only' && (m.fi != null || m.ei != null) && m.quality == 'limited' && m.provisional == true)
              || (m.scope == 'bands-only' && m.fi == null && m.cli == null && m.ei == null && m.classification == 'unavailable'));
        }
        function validLive(d) {
          let p = get(profilePath(request.auth.uid)).data;
          return d.keys().hasAll(['schemaVersion','companyCode','ownerUid','memberId','source','status','receivedSamples','preparationRemaining','measurement','updatedAt'])
            && d.keys().hasOnly(['schemaVersion','companyCode','ownerUid','memberId','source','status','receivedSamples','preparationRemaining','measurement','updatedAt'])
            && uid == request.auth.uid && p.role == 'pekerja' && d.schemaVersion == 1 && d.source == 'muse'
            && d.companyCode == code && d.ownerUid == request.auth.uid && d.memberId == p.memberId
            && d.status in ['live','preparing','waiting','disconnected','stopped']
            && d.receivedSamples is int && d.receivedSamples >= 0 && d.receivedSamples <= 47923200
            && d.preparationRemaining is int && d.preparationRemaining >= 0 && d.preparationRemaining <= 60
            && ((d.status == 'live' && measurement(d.measurement)) || (d.status != 'live' && d.measurement == null))
            && d.updatedAt == request.time;
        }
        allow get: if verified() && active(code) && (staff(code) || uid == request.auth.uid);
        allow list: if verified() && staff(code);
        allow create, update: if verified() && active(code) && validLive(request.resource.data);
        allow delete: if false;
      }
      match /workerAlerts/{id} {
        function validAlert(a) {
          return a.keys().hasAll(['schemaVersion','recipientUid','memberId','senderUid','title','message','severity','createdAt','acknowledgedAt','resolvedAt','resolvedBy'])
            && a.keys().hasOnly(['schemaVersion','recipientUid','memberId','senderUid','title','message','severity','createdAt','acknowledgedAt','resolvedAt','resolvedBy'])
            && a.schemaVersion == 1 && a.recipientUid is string && a.recipientUid.size() > 0
            && a.memberId is string && a.senderUid == request.auth.uid
            && a.title is string && a.title.size() > 0 && a.title.size() <= 100
            && a.message is string && a.message.size() > 0 && a.message.size() <= 1000
            && a.severity in ['info','attention','urgent'] && a.createdAt == request.time
            && a.acknowledgedAt == null && a.resolvedAt == null && a.resolvedBy == null
            && get(memberPath(code,a.memberId)).data.uid == a.recipientUid
            && get(memberPath(code,a.memberId)).data.role == 'pekerja'
            && get(memberPath(code,a.memberId)).data.status == 'active';
        }
        allow read: if verified() && active(code) && (staff(code) || resource.data.recipientUid == request.auth.uid);
        allow create: if verified() && staff(code) && validAlert(request.resource.data);
        allow update: if verified() && active(code) && resource.data.resolvedAt == null && (
          (resource.data.recipientUid == request.auth.uid && resource.data.acknowledgedAt == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acknowledgedAt'])
            && request.resource.data.acknowledgedAt == request.time)
          || (staff(code) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolvedAt','resolvedBy'])
            && request.resource.data.resolvedAt == request.time && request.resource.data.resolvedBy == request.auth.uid));
        allow delete: if false;
      }
      match /sessionReviews/{id} {
        allow read: if verified() && active(code) && (staff(code) || resource.data.ownerUid == request.auth.uid);
        allow create: if verified() && staff(code)
          && request.resource.data.keys().hasOnly(['schemaVersion','sessionId','ownerUid','reviewerUid','status','note','updatedAt'])
          && request.resource.data.schemaVersion == 1 && request.resource.data.sessionId == id
          && request.resource.data.reviewerUid == request.auth.uid && request.resource.data.status == 'reviewed'
          && request.resource.data.note is string && request.resource.data.note.size() > 0 && request.resource.data.note.size() <= 1000
          && request.resource.data.updatedAt == request.time
          && get(/databases/$(database)/documents/companies/$(code)/sessions/$(id)).data.status in ['completed','interrupted']
          && request.resource.data.ownerUid == get(/databases/$(database)/documents/companies/$(code)/sessions/$(id)).data.ownerUid;
        allow update, delete: if false;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
