{
  "hosting": {
    "public": ".firebase/hosting-public",
    "predeploy": ["node scripts/build-hosting.js"],
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".firebase/**",
      "**/.*",
      "**/.*/**",
      ".git/**",
      "**/node_modules/**",
      ".claude/**",
      "**/*.md",
      "tests/**",
      "check-syntax.js",
      "package*.json",
      "functions/**",
      "scripts/**",
      "private/**",
      ".tools/**",
      "firestore.rules",
      "firebase-debug.*",
      "*-debug.log"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/service-worker.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }, { "key": "Service-Worker-Allowed", "value": "/" }] },
      { "source": "/manifest.webmanifest", "headers": [{ "key": "Cache-Control", "value": "no-cache" }, { "key": "Content-Type", "value": "application/manifest+json" }] },
      { "source": "**/*.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "auth": { "host": "127.0.0.1", "port": 9099 },
    "firestore": { "host": "127.0.0.1", "port": 8080 },
    "hosting": { "host": "127.0.0.1", "port": 5000 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
